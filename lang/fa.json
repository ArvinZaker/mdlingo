[{"id":"general-2","field":"general","stage":"timing","english":"How long has it been happening?","note":"","reviewer":"","translation":"از کی شروع شده؟"},{"id":"general-3","field":"general","stage":"timing","english":"How many times a day?","note":"","reviewer":"","translation":"چند بار در روز؟"},{"id":"general-4","field":"general","stage":"timing","english":"When did it start?","note":"","reviewer":"","translation":"از کی شروع شده؟"},{"id":"general-5","field":"general","stage":"timing","english":"Is it always there or does it come and go?","note":"","reviewer":"","translation":"همیشه هست یا گاهی می‌آید؟"},{"id":"general-6","field":"general","stage":"timing","english":"Did it start suddenly?","note":"","reviewer":"","translation":"ناگهانی شروع شد؟"},{"id":"general-18","field":"general","stage":"location","english":"Where is the tingling?","note":"","reviewer":"","translation":"گزگز کجای بدن است؟"},{"id":"general-19","field":"general","stage":"location","english":"Where is the numbness?","note":"","reviewer":"","translation":"بی‌حسی کجای بدن است؟"},{"id":"general-20","field":"general","stage":"location","english":"Is the yellowing in the skin or the whites of the eyes?","note":"","reviewer":"","translation":"زردی پوست است یا سفیدی چشم؟"},{"id":"general-21","field":"general","stage":"location","english":"Where are the white patches?","note":"","reviewer":"","translation":"سفیدی کجاست؟"},{"id":"general-22","field":"general","stage":"location","english":"Where is the redness?","note":"","reviewer":"","translation":"قرمزی کجاست؟"},{"id":"general-30","field":"general","stage":"symptoms","english":"Do you feel cold or have chills?","note":"","reviewer":"","translation":"احساس سرما دارید یا لرز؟"},{"id":"general-31","field":"general","stage":"symptoms","english":"Do you have a fever?","note":"","reviewer":"","translation":"تب دارید؟"},{"id":"general-32","field":"general","stage":"symptoms","english":"Is there numbness, burning, pain, or weakness?","note":"","reviewer":"","translation":"بی‌حسی، سوزش، درد یا ضعف هم دارید؟"},{"id":"general-33","field":"general","stage":"symptoms","english":"Do you have throat pain or swelling?","note":"","reviewer":"","translation":"گلودرد یا ورم دارید؟"},{"id":"general-34","field":"general","stage":"symptoms","english":"Is your urine darker than usual?","note":"","reviewer":"","translation":"ادرار تیره‌تر شده؟"},{"id":"general-35","field":"general","stage":"symptoms","english":"Do they come off when wiped?","note":"","reviewer":"","translation":"با پاک کردن می‌رود؟"},{"id":"general-36","field":"general","stage":"symptoms","english":"Are they painful?","note":"","reviewer":"","translation":"درد دارد؟"},{"id":"general-37","field":"general","stage":"symptoms","english":"Is there itching, pain, swelling, or warmth?","note":"","reviewer":"","translation":"خارش، درد، ورم یا گرمی دارد؟"},{"id":"general-65","field":"general","stage":"red flags","english":"Is there blood, fever, or severe pain?","note":"","reviewer":"","translation":"خون در مدفوع، تب، یا درد شدید دارید؟"},{"id":"general-66","field":"general","stage":"red flags","english":"Can you keep fluids down?","note":"","reviewer":"","translation":"می‌توانید مایعات را نگه دارید؟"},{"id":"general-67","field":"general","stage":"red flags","english":"Do you have weakness or trouble speaking?","note":"","reviewer":"","translation":"ضعف یا مشکل در حرف زدن دارید؟"},{"id":"general-68","field":"general","stage":"red flags","english":"Is breathing or swallowing difficult?","note":"","reviewer":"","translation":"نفس کشیدن یا قورت دادن سخت است؟"}]
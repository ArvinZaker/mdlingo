[{"id":"eye-intro-doctor","field":"eye","stage":"eye-intro","english":"I am your eye doctor.","linked_terms":[],"translation":"Tôi là bác sĩ mắt của ông/bà.","transliteration":"toy lah bahk see maht kwah ohng/bah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-sit","field":"eye","stage":"eye-intro","english":"Please sit here.","linked_terms":[],"translation":"Xin mời ngồi đây.","transliteration":"sin muh-ee ngoy day","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-pain","field":"eye","stage":"eye-intro","english":"Does it hurt? Point to where.","linked_terms":[],"translation":"Có đau không? Xin chỉ chỗ đau.","transliteration":"kaw dow khohng? sin chee choh dow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-fam-glaucoma","field":"eye","stage":"eye-intro","english":"Do you have a family history of glaucoma?","linked_terms":[],"translation":"Trong gia đình có ai bị tăng nhãn áp (cườm nước) không?","transliteration":"chong yah din kaw eye bee tahng nyahn ahp (kuhm nook) khohng?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-glasses-on","field":"eye","stage":"eye-acuity","english":"Put your glasses on.","linked_terms":[],"translation":"Xin đeo kính vào.","transliteration":"sin day-oh king vow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-cover-left","field":"eye","stage":"eye-acuity","english":"Cover your left eye.","linked_terms":[],"translation":"Xin che mắt trái lại.","transliteration":"sin cheh maht chai lai","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-cover-right","field":"eye","stage":"eye-acuity","english":"Cover your right eye.","linked_terms":[],"translation":"Xin che mắt phải lại.","transliteration":"sin cheh maht fai lai","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-ask","field":"eye","stage":"eye-acuity","english":"Does your vision look like any of these? Point to the closest one.","linked_terms":[],"translation":"Mắt ông/bà giống hình nào? Xin chỉ hình giống nhất.","transliteration":"maht ohng/bah yohng hin now? sin chee hin yohng nyut","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-read-line","field":"eye","stage":"eye-acuity","english":"Please read the smallest line you can see.","linked_terms":[],"translation":"Xin đọc dòng nhỏ nhất mà ông/bà nhìn thấy.","transliteration":"sin dawk yawng nyaw nyut mah ohng/bah nyin thay","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-pinhole","field":"eye","stage":"eye-acuity","english":"Try to look through the tiny hole. It may make your vision clearer.","linked_terms":[],"translation":"Xin nhìn qua lỗ nhỏ, có thể rõ hơn.","transliteration":"sin nyin kwah loh nyaw, kaw theh raw huhn","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-fingers","field":"eye","stage":"eye-acuity","english":"How many fingers?","linked_terms":[],"translation":"Mấy ngón tay?","transliteration":"may ngawn tie?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-hand-motion","field":"eye","stage":"eye-acuity","english":"Do you see my hand moving?","linked_terms":[],"translation":"Ông/bà có thấy tay tôi đang di chuyển không?","transliteration":"ohng/bah kaw thay tie toy dahng yee chwee-en khohng?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-see-this","field":"eye","stage":"eye-acuity","english":"Can you see this?","linked_terms":[],"translation":"Ông/bà có thấy cái này không?","transliteration":"ohng/bah kaw thay kai nay khohng?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-light-move","field":"eye","stage":"eye-acuity","english":"Tell me if you see the light move.","linked_terms":[],"translation":"Nếu thấy ánh sáng di chuyển, xin cho tôi biết.","transliteration":"nay-oo thay ang sahng yee chwee-en, sin chaw toy bee-et","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-look-nose","field":"eye","stage":"eye-acuity","english":"Look at my nose.","linked_terms":[],"translation":"Xin nhìn vào mũi tôi.","transliteration":"sin nyin vow moo-ee toy","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-double","field":"eye","stage":"eye-acuity","english":"Do you see two of me?","linked_terms":[],"translation":"Ông/bà có thấy hai người tôi không?","transliteration":"ohng/bah kaw thay high ngoo-ee toy khohng?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-worse-direction","field":"eye","stage":"eye-acuity","english":"Is it worse looking this way?","linked_terms":[],"translation":"Nhìn về hướng này có nặng hơn không?","transliteration":"nyin veh hoong nay kaw nahng huhn khohng?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-shine","field":"eye","stage":"eye-pupils","english":"I am going to shine a light in your eyes. Please look at the wall behind me.","linked_terms":[],"translation":"Tôi sẽ chiếu đèn vào mắt. Xin nhìn vào bức tường sau lưng tôi.","transliteration":"toy seh chee-oo den vow maht. sin nyin vow buke tuong sow lung toy","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-dont-look-light","field":"eye","stage":"eye-pupils","english":"Do not look at the light. Keep looking far away.","linked_terms":[],"translation":"Đừng nhìn đèn, xin nhìn ra xa.","transliteration":"dung nyin den, sin nyin rah sah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-both-open","field":"eye","stage":"eye-pupils","english":"Keep both eyes open.","linked_terms":[],"translation":"Xin mở cả hai mắt.","transliteration":"sin muh kah high maht","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-look-here","field":"eye","stage":"eye-motility","english":"Look here.","linked_terms":[],"translation":"Nhìn vào đây.","transliteration":"nyin vow day","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-finger","field":"eye","stage":"eye-motility","english":"Look at my finger. Do not move your head.","linked_terms":[],"translation":"Xin nhìn ngón tay tôi. Đừng quay đầu.","transliteration":"sin nyin ngawn tie toy. dung kway dow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-up","field":"eye","stage":"eye-motility","english":"Look up.","linked_terms":[],"translation":"Nhìn lên.","transliteration":"nyin len","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-down","field":"eye","stage":"eye-motility","english":"Look down.","linked_terms":[],"translation":"Nhìn xuống.","transliteration":"nyin soo-ong","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-left","field":"eye","stage":"eye-motility","english":"Look left.","linked_terms":[],"translation":"Nhìn sang trái.","transliteration":"nyin sahng chai","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-right","field":"eye","stage":"eye-motility","english":"Look right.","linked_terms":[],"translation":"Nhìn sang phải.","transliteration":"nyin sahng fai","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-straight","field":"eye","stage":"eye-motility","english":"Look straight ahead.","linked_terms":[],"translation":"Nhìn thẳng phía trước.","transliteration":"nyin thahng fee-a chuke","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-check","field":"eye","stage":"eye-pressure","english":"I am going to check the pressure in your eye.","linked_terms":[],"translation":"Tôi sẽ đo áp suất mắt.","transliteration":"toy seh daw ahp swut maht","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-no-hurt","field":"eye","stage":"eye-pressure","english":"This does not hurt. You will feel a light touch on your eye.","linked_terms":[],"translation":"Việc này không đau. Ông/bà sẽ thấy chạm nhẹ vào mắt.","transliteration":"vee-ek nay khohng dow. ohng/bah seh thay chahm nyeh vow maht","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-still","field":"eye","stage":"eye-pressure","english":"Please look straight ahead and hold still. Try not to blink.","linked_terms":[],"translation":"Xin nhìn thẳng, giữ yên và đừng chớp mắt.","transliteration":"sin nyin thahng, yu een vah dung chuhp maht","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-fix","field":"eye","stage":"eye-fields","english":"Keep looking at my nose, not at my hand.","linked_terms":[],"translation":"Xin nhìn mũi tôi, đừng nhìn tay tôi.","transliteration":"sin nyin moo-ee toy, dung nyin tie toy","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-raise","field":"eye","stage":"eye-fields","english":"Raise your hand when you see my fingers.","linked_terms":[],"translation":"Khi thấy ngón tay tôi, xin giơ tay lên.","transliteration":"khee thay ngawn tie toy, sin yuh tie len","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-count","field":"eye","stage":"eye-fields","english":"How many fingers do you see now?","linked_terms":[],"translation":"Bây giờ thấy mấy ngón tay?","transliteration":"bay yuh thay may ngawn tie?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-allergy","field":"eye","stage":"eye-drops","english":"Are you allergic to any medications?","linked_terms":[],"translation":"Ông/bà có dị ứng thuốc nào không?","transliteration":"ohng/bah kaw yee ung too-ok now khohng?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-putting","field":"eye","stage":"eye-drops","english":"I'm going to put drops in your eye.","linked_terms":[],"translation":"Tôi sẽ nhỏ thuốc vào mắt.","transliteration":"toy seh nyaw too-ok vow maht","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-look-up","field":"eye","stage":"eye-drops","english":"Please look up.","linked_terms":[],"translation":"Xin nhìn lên.","transliteration":"sin nyin len","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-anaesthetic","field":"eye","stage":"eye-drops","english":"This is an analgesic for your eyes. It may sting for a few seconds.","linked_terms":[],"translation":"Đây là thuốc tê mắt. Có thể xót vài giây.","transliteration":"day lah too-ok tay maht. kaw theh sawt vai yay","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-dilate","field":"eye","stage":"eye-drops","english":"This drop will dilate your pupils.","linked_terms":[],"translation":"Thuốc này sẽ làm giãn đồng tử.","transliteration":"too-ok nay seh lahm yahn dohng tu","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-blurry","field":"eye","stage":"eye-drops","english":"Your vision will be blurry for about 6 hours.","linked_terms":[],"translation":"Mắt sẽ mờ khoảng sáu tiếng.","transliteration":"maht seh muh khwahng sow tee-eng","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-close","field":"eye","stage":"eye-drops","english":"Please close your eyes.","linked_terms":[],"translation":"Xin nhắm mắt lại.","transliteration":"sin nyam maht lai","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-no-rub","field":"eye","stage":"eye-drops","english":"Don't rub your eyes.","linked_terms":[],"translation":"Đừng dụi mắt.","transliteration":"dung yoo-ee maht","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-chin","field":"eye","stage":"eye-slitlamp","english":"Chin on the rest, forehead against the bar.","linked_terms":[],"translation":"Đặt cằm vào đây và áp trán vào thanh này.","transliteration":"daht kahm vow day vah ahp chahn vow tahn nay","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-open","field":"eye","stage":"eye-slitlamp","english":"Open your eyes wide.","linked_terms":[],"translation":"Xin mở mắt thật to.","transliteration":"sin muh maht thut taw","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-no-pull-back","field":"eye","stage":"eye-slitlamp","english":"Don't pull your head back.","linked_terms":[],"translation":"Đừng ngả đầu ra sau.","transliteration":"dung ngah dow rah sow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-bright","field":"eye","stage":"eye-slitlamp","english":"The light is bright. Please bear with it.","linked_terms":[],"translation":"Đèn rất sáng. Xin chịu khó một chút.","transliteration":"den rut sahng. sin chee-oo khaw moht choot","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-ear","field":"eye","stage":"eye-slitlamp","english":"Look at my ear.","linked_terms":[],"translation":"Xin nhìn vào tai tôi.","transliteration":"sin nyin vow tie toy","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-touch-lid","field":"eye","stage":"eye-slitlamp","english":"I'm going to touch your eyelid.","linked_terms":[],"translation":"Tôi sẽ chạm vào mí mắt.","transliteration":"toy seh chahm vow mee maht","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-almost","field":"eye","stage":"eye-slitlamp","english":"Almost done.","linked_terms":[],"translation":"Sắp xong rồi.","transliteration":"sahp sawng roy","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-finished","field":"eye","stage":"eye-closing","english":"The exam is finished. Thank you.","linked_terms":[],"translation":"Khám xong rồi. Cảm ơn ông/bà.","transliteration":"khahm sawng roy. kahm uhn ohng/bah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-healthy","field":"eye","stage":"eye-closing","english":"Your eyes are healthy.","linked_terms":[],"translation":"Mắt của ông/bà khỏe mạnh.","transliteration":"maht kwah ohng/bah khwe mahn","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-consult","field":"eye","stage":"eye-closing","english":"I will have to speak to another doctor about your eyes. I will be back.","linked_terms":[],"translation":"Tôi cần trao đổi với bác sĩ khác về mắt của ông/bà. Tôi sẽ quay lại.","transliteration":"toy kun chow doy vuh-ee bahk see khahk veh maht kwah ohng/bah. toy seh kway lai","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-interpreter","field":"eye","stage":"eye-closing","english":"We will use an interpreter to explain the results.","linked_terms":[],"translation":"Chúng tôi sẽ nhờ thông dịch viên giải thích kết quả.","transliteration":"choong toy seh nyuh thohng yik vee-en yai thik ket kwah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-dip-ask","field":"eye","stage":"eye-acuity","english":"If you see two — how are they arranged? Point.","linked_terms":[],"translation":"Nếu thấy hai hình, chúng nằm thế nào? Xin chỉ.","transliteration":"nay-oo thay high hin, choong nahm theh now? sin chee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-dip-ask-dip-single","field":"eye","stage":"eye-acuity","english":"Single","linked_terms":[],"translation":"Một","transliteration":"moht","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-dip-ask-dip-h","field":"eye","stage":"eye-acuity","english":"Side by side","linked_terms":[],"translation":"Cạnh nhau","transliteration":"kahn nyow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-dip-ask-dip-v","field":"eye","stage":"eye-acuity","english":"One above","linked_terms":[],"translation":"Trên dưới","transliteration":"chen yoo-ee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-normal","field":"eye","stage":"eye-symptoms","english":"Normal","linked_terms":[],"translation":"Bình thường","transliteration":"","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-blur","field":"eye","stage":"eye-symptoms","english":"Blurry","linked_terms":[],"translation":"Mờ","transliteration":"","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-distort","field":"eye","stage":"eye-symptoms","english":"Wavy or bent","linked_terms":[],"translation":"Cong vênh","transliteration":"","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-faded","field":"eye"
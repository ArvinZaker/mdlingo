[{"id":"eye-intro-doctor","field":"eye","stage":"eye-intro","english":"I am your eye doctor.","linked_terms":[],"translation":"我是您的眼科医生。","transliteration":"waw shr nin duh yen-kuh yee-shung","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-sit","field":"eye","stage":"eye-intro","english":"Please sit here.","linked_terms":[],"translation":"请坐这里。","transliteration":"ching dzwaw jur-lee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-pain","field":"eye","stage":"eye-intro","english":"Does it hurt? Point to where.","linked_terms":[],"translation":"痛吗？哪里痛？请指一下。","transliteration":"tong mah? nah-lee tong? ching jr yee-shyah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-fam-glaucoma","field":"eye","stage":"eye-intro","english":"Do you have a family history of glaucoma?","linked_terms":[],"translation":"您家里有人得过青光眼吗？","transliteration":"nin jyah-lee yoe run duh gwaw ching-gwahng-yen mah?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-glasses-on","field":"eye","stage":"eye-acuity","english":"Put your glasses on.","linked_terms":[],"translation":"请把眼镜戴上。","transliteration":"ching bah yen-jing dye shahng","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-cover-left","field":"eye","stage":"eye-acuity","english":"Cover your left eye.","linked_terms":[],"translation":"请遮住左眼。","transliteration":"ching juh-joo dzwaw yen","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-cover-right","field":"eye","stage":"eye-acuity","english":"Cover your right eye.","linked_terms":[],"translation":"请遮住右眼。","transliteration":"ching juh-joo yoe yen","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-ask","field":"eye","stage":"eye-acuity","english":"Does your vision look like any of these? Point to the closest one.","linked_terms":[],"translation":"您的视力像哪一个？请指最接近的。","transliteration":"nin duh shr-lee shyahng nah yee-guh? ching jr dzway jyeh-jin duh","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-read-line","field":"eye","stage":"eye-acuity","english":"Please read the smallest line you can see.","linked_terms":[],"translation":"请念您能看到的最小的一行。","transliteration":"ching nyen nin nung kahn-dow duh dzway shyow duh ee hahng","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-pinhole","field":"eye","stage":"eye-acuity","english":"Try to look through the tiny hole. It may make your vision clearer.","linked_terms":[],"translation":"请透过小孔看，可能会更清楚。","transliteration":"ching toe-gwaw shyow-kong kahn, kuh-nung hway gung ching-choo","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-fingers","field":"eye","stage":"eye-acuity","english":"How many fingers?","linked_terms":[],"translation":"几根手指？","transliteration":"jee gun show-jr?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-hand-motion","field":"eye","stage":"eye-acuity","english":"Do you see my hand moving?","linked_terms":[],"translation":"您看到我的手在动吗？","transliteration":"nin kahn-dow waw duh show dzye dong mah?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-see-this","field":"eye","stage":"eye-acuity","english":"Can you see this?","linked_terms":[],"translation":"看得见吗？","transliteration":"kahn duh jyen mah?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-light-move","field":"eye","stage":"eye-acuity","english":"Tell me if you see the light move.","linked_terms":[],"translation":"看到光移动请告诉我。","transliteration":"kahn-dow gwahng yee-dong ching gow-soo waw","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-look-nose","field":"eye","stage":"eye-acuity","english":"Look at my nose.","linked_terms":[],"translation":"请看我的鼻子。","transliteration":"ching kahn waw duh bee-dzuh","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-double","field":"eye","stage":"eye-acuity","english":"Do you see two of me?","linked_terms":[],"translation":"您看到两个我吗？","transliteration":"nin kahn-dow lyahng guh waw mah?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-worse-direction","field":"eye","stage":"eye-acuity","english":"Is it worse looking this way?","linked_terms":[],"translation":"看这个方向更严重吗？","transliteration":"kahn juh-guh fahng-shyahng gung yen-jong mah?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-shine","field":"eye","stage":"eye-pupils","english":"I am going to shine a light in your eyes. Please look at the wall behind me.","linked_terms":[],"translation":"我要用灯照您的眼睛，请看我身后的墙。","transliteration":"waw yow yong dung jow nin duh yen-jing, ching kahn waw shun-hoe duh chyahng","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-dont-look-light","field":"eye","stage":"eye-pupils","english":"Do not look at the light. Keep looking far away.","linked_terms":[],"translation":"不要看灯，一直看远处。","transliteration":"boo-yow kahn dung, yee-jr kahn ywen-choo","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-both-open","field":"eye","stage":"eye-pupils","english":"Keep both eyes open.","linked_terms":[],"translation":"两只眼睛都睁开。","transliteration":"lyahng jr yen-jing doe jung-kye","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-look-here","field":"eye",
ator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-no-hurt","field":"eye","stage":"eye-pressure","english":"This does not hurt. You will feel a light touch on your eye.","linked_terms":[],"translation":"这不会痛，您会感觉眼睛被轻轻碰到。","transliteration":"juh boo-hway tong, nin hway gahn-jyweh yen-jing bay ching-ching pung-dow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-still","field":"eye","stage":"eye-pressure","english":"Please look straight ahead and hold still. Try not to blink.","linked_terms":[],"translation":"请看正前方，不要动，尽量不要眨眼。","transliteration":"ching kahn jung chyen-fahng, boo-yow dong, jin-lyahng boo-yow jah-yen","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-fix","field":"eye","stage":"eye-fields","english":"Keep looking at my nose, not at my hand.","linked_terms":[],"translation":"一直看着我的鼻子，不要看我的手。","transliteration":"yee-jr kahn-juh waw duh bee-dzuh, boo-yow kahn waw duh show","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-raise","field":"eye","stage":"eye-fields","english":"Raise your hand when you see my fingers.","linked_terms":[],"translation":"看到我的手指请举手。","transliteration":"kahn-dow waw duh show-jr ching jyu show","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-count","field":"eye","stage":"eye-fields","english":"How many fingers do you see now?","linked_terms":[],"translation":"现在看到几根手指？","transliteration":"shyen-dzye kahn-dow jee gun show-jr?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-allergy","field":"eye","stage":"eye-drops","english":"Are you allergic to any medications?","linked_terms":[],"translation":"您对药物过敏吗？","transliteration":"nin dway yow-woo gwaw-min mah?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-putting","field":"eye","stage":"eye-drops","english":"I'm going to put drops in your eye.","linked_terms":[],"translation":"我要给您点眼药水。","transliteration":"waw yow gay nin dyen yen-yow-shway","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-look-up","field":"eye","stage":"eye-drops","english":"Please look up.","linked_terms":[],"translation":"请往上看。","transliteration":"ching wahng shahng kahn","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-anaesthetic","field":"eye","stage":"eye-drops","english":"This is an analgesic for your eyes. It may sting for a few seconds.","linked_terms":[],"translation":"这是眼睛的麻药，可能会刺痛几秒钟。","transliteration":"juh shr yen-jing duh mah-yow, kuh-nung hway tsz-tong jee myow-jong","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-dilate","field":"eye","stage":"eye-drops","english":"This drop will dilate your pupils.","linked_terms":[],"translation":"这是散瞳药水。","transliteration":"juh shr sahn-tong yow-shway","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-blurry","field":"eye","stage":"eye-drops","english":"Your vision will be blurry for about 6 hours.","linked_terms":[],"translation":"您的视力会模糊大约六个小时。","transliteration":"nin duh shr-lee hway maw-hoo dah-yweh lyo guh shyow-shr","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-close","field":"eye","stage":"eye-drops","english":"Please close your eyes.","linked_terms":[],"translation":"请闭上眼睛。","transliteration":"ching bee shahng yen-jing","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-no-rub","field":"eye","stage":"eye-drops","english":"Don't rub your eyes.","linked_terms":[],"translation":"不要揉眼睛。","transliteration":"boo-yow roe yen-jing","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-chin","field":"eye","stage":"eye-slitlamp","english":"Chin on the rest, forehead against the bar.","linked_terms":[],"translation":"下巴放在这里，额头靠着这里。","transliteration":"shyah-bah fahng dzye jur-lee, uh-toe kow-juh jur-lee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-open","field":"eye","stage":"eye-slitlamp","english":"Open your eyes wide.","linked_terms":[],"translation":"请把眼睛睁大。","transliteration":"ching bah yen-jing jung dah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-no-pull-back","field":"eye","stage":"eye-slitlamp","english":"Don't pull your head back.","linked_terms":[],"translation":"头不要往后退。","transliteration":"toe boo-yow wahng hoe tway","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-bright","field":"eye","stage":"eye-slitlamp","english":"The light is bright. Please bear with it.","linked_terms":[],"translation":"灯会很亮，请忍一下。","transliteration":"dung hway hun lyahng, ching run yee-shyah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-ear","field":"eye","stage":"eye-slitlamp","english":"Look at my ear.","linked_terms":[],"translation":"请看我的耳朵。","transliteration":"ching kahn waw duh are-dwaw","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-touch-lid","field":"eye","stage":"eye-slitlamp","english":"I'm going to touch your eyelid.","linked_terms":[],"translation":"我要碰一下您的眼皮。","transliteration":"waw yow pung yee-shyah nin duh yen-pee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-almost","field":"eye","stage":"eye-slitlamp","english":"Almost done.","linked_terms":[],"translation":"快好了。","transliteration":"kwye how luh","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-finished","field":"eye","stage":"eye-closing","english":"The exam is finished. Thank you.","linked_terms":[],"translation":"检查完了，谢谢您。","transliteration":"jyen-chah wahn luh, shyeh-shyeh nin","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-healthy","field":"eye","stage":"eye-closing","english":"Your eyes are healthy.","linked_terms":[],"translation":"您的眼睛很健康。","transliteration":"nin duh yen-jing hun jyen-kahng","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-consult","field":"eye","stage":"eye-closing","english":"I will have to speak to another doctor about your eyes. I will be back.","linked_terms":[],"translation":"我需要和另一位医生讨论您的眼睛，我一会儿回来。","transliteration":"waw shyu-yow huh ling-yee-way yee-shung tao-lwun nin duh yen-jing, waw yee-hwar hway-lye","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-interpreter","field":"eye","stage":"eye-closing","english":"We will use an interpreter to explain the results.","linked_terms":[],"translation":"我们会用翻译跟您解释检查结果。","transliteration":"waw-mun hway yong fahn-ee gun nin jyeh-shr jyen-chah jyeh-gwaw","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-dip-ask","field":"eye","stage":"eye-acuity","english":"If you see two — how are they arranged? Point.","linked_terms":[],"translation":"如果看到两个，是怎么排的？请指一下。","transliteration":"roo-gwaw kahn-dow lyahng guh, shr dzun-muh pye duh? ching jr yee-shyah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-dip-ask-dip-single","field":"eye","stage":"eye-acuity","english":"Single","linked_terms":[],"translation":"一个","transliteration":"ee guh","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-dip-ask-dip-h","field":"eye","stage":"eye-acuity","english":"Side by side","linked_terms":[],"translation":"左右","transliteration":"dzwaw-yoe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-dip-ask-dip-v","field":"eye","stage":"eye-acuity","english":"One above","linked_terms":[],"translation":"上下","transliteration":"shahng-shyah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-normal","field":"eye","stage":"eye-symptoms","english":"Normal","linked_terms":[],"translation":"正常","transliteration":"","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-blur","field":"eye","stage":"eye-symptoms","english":"Blurry","linked_terms":[],"translation":"模糊","transliteration":"","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-distort","field":"eye","stage":"eye-symptoms","english":"Wavy or bent","linked_terms":[],"translation":"扭曲弯曲","transliteration":"","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-faded","field":"eye","stage":"eye-symptoms","english":"Faded","linked_terms":[],"translation":"发白暗淡","transliteration":"","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-central","field":"eye","stage":"eye-symptoms","english":"Dark in the middle","linked_terms":[],"translation":"中间发黑","transliteration":"","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-curtain","field":"eye","stage":"eye-symptoms","english":"Curtain across","linked_terms":[],"translation":"有帘子遮住","transliteration":"","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-floaters","field":"eye","stage":"eye-symptoms","english":"Specks or cobwebs","linked_terms":[],"translation":"黑点或蛛网","transliteration":""
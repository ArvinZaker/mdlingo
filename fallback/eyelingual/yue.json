[{"id":"eye-intro-doctor","field":"eye","stage":"eye-intro","english":"I am your eye doctor.","linked_terms":[],"translation":"我係你嘅眼科醫生。","transliteration":"ngaw high nay geh ngahn-faw yee-sahng","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-sit","field":"eye","stage":"eye-intro","english":"Please sit here.","linked_terms":[],"translation":"請坐喺呢度。","transliteration":"ching chaw high nee-doh","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-pain","field":"eye","stage":"eye-intro","english":"Does it hurt? Point to where.","linked_terms":[],"translation":"痛唔痛？邊度痛？指俾我睇。","transliteration":"tung mm tung? bin-doh tung? jee bay ngaw tye","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-fam-glaucoma","field":"eye","stage":"eye-intro","english":"Do you have a family history of glaucoma?","linked_terms":[],"translation":"你家人有冇人生過青光眼？","transliteration":"nay gah-yun yow-moe yun sahng gaw ching-gwong-ngahn?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-glasses-on","field":"eye","stage":"eye-acuity","english":"Put your glasses on.","linked_terms":[],"translation":"請戴返眼鏡。","transliteration":"ching dye-fahn ngahn-geng","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-cover-left","field":"eye","stage":"eye-acuity","english":"Cover your left eye.","linked_terms":[],"translation":"請遮住左眼。","transliteration":"ching jeh-jyu jaw ngahn","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-cover-right","field":"eye","stage":"eye-acuity","english":"Cover your right eye.","linked_terms":[],"translation":"請遮住右眼。","transliteration":"ching jeh-jyu yow ngahn","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-ask","field":"eye","stage":"eye-acuity","english":"Does your vision look like any of these? Point to the closest one.","linked_terms":[],"translation":"你嘅視力似邊個？請指最接近嗰個。","transliteration":"nay geh see-lick chee bin-gaw? ching jee joy jip-gun gaw-gaw","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-read-line","field":"eye","stage":"eye-acuity","english":"Please read the smallest line you can see.","linked_terms":[],"translation":"請讀你睇到最細嗰行。","transliteration":"ching duke nay tye-doh joy sye gaw hong","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-pinhole","field":"eye","stage":"eye-acuity","english":"Try to look through the tiny hole. It may make your vision clearer.","linked_terms":[],"translation":"請透過個細窿望，可能會清楚啲。","transliteration":"ching tow-gwaw gaw sai-lung mong, haw-nahng wooi ching-chaw dee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-fingers","field":"eye","stage":"eye-acuity","english":"How many fingers?","linked_terms":[],"translation":"幾多隻手指？","transliteration":"gay-daw jek sow-jee?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-hand-motion","field":"eye","stage":"eye-acuity","english":"Do you see my hand moving?","linked_terms":[],"translation":"你見唔見到我隻手郁？","transliteration":"nay gin mm gin-doh ngaw jek sow yuke?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-see-this","field":"eye","stage":"eye-acuity","english":"Can you see this?","linked_terms":[],"translation":"睇唔睇到？","transliteration":"tye mm tye-doh?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-light-move","field":"eye","stage":"eye-acuity","english":"Tell me if you see the light move.","linked_terms":[],"translation":"見到光郁請話我知。","transliteration":"gin-doh gwong yuke ching wah ngaw jee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-look-nose","field":"eye","stage":"eye-acuity","english":"Look at my nose.","linked_terms":[],"translation":"望住我個鼻。","transliteration":"mong-jyu ngaw gaw bay","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-double","field":"eye","stage":"eye-acuity","english":"Do you see two of me?","linked_terms":[],"translation":"你係咪見到兩個我？","transliteration":"nay high-my gin-doh leung gaw ngaw?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-worse-direction","field":"eye","stage":"eye-acuity","english":"Is it worse looking this way?","linked_terms":[],"translation":"望呢邊會唔會嚴重啲？","transliteration":"mong nee-bin wooi mm wooi yim-jung dee?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-shine","field":"eye","stage":"eye-pupils","english":"I am going to shine a light in your eyes. Please look at the wall behind me.","linked_terms":[],"translation":"我要用燈照你對眼，請望我後面嘅牆。","transliteration":"ngaw yiu yong dahng jiu nay doy ngahn, ching mong ngaw how-min geh cheung","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-dont-look-light","field":"eye","stage":"eye-pupils","english":"Do not look at the light. Keep looking far away.","linked_terms":[],"translation":"唔好望住個燈，一直望遠啲。","transliteration":"mm-hoe mong-jyu gaw dahng, yat-jick mong yune dee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-both-open","field":"eye","stage":"eye-pupils","english":"Keep both eyes open.","linked_terms":[],"translation":"兩隻眼都要擘大。","transliteration":"leung jek ngahn doe yiu mahk dye","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-look-here","field":"eye","stage":"eye-motility","english":"Look here.","linked_terms":[],"translation":"望呢度。","transliteration":"mong nee-doh","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-finger","field":"eye","stage":"eye-motility","english":"Look at my finger. Do not move your head.","linked_terms":[],"translation":"望住我隻手指，唔好郁個頭。","transliteration":"mong-jyu ngaw jek sow-jee, mm-hoe yuke gaw tow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-up","field":"eye","stage":"eye-motility","english":"Look up.","linked_terms":[],"translation":"望上。","transliteration":"mong seung","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-down","field":"eye","stage":"eye-motility","english":"Look down.","linked_terms":[],"translation":"望落。","transliteration":"mong lok","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-left","field":"eye","stage":"eye-motility","english":"Look left.","linked_terms":[],"translation":"望左。","transliteration":"mong jaw","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-right","field":"eye","stage":"eye-motility","english":"Look right.","linked_terms":[],"translation":"望右。","transliteration":"mong yow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-straight","field":"eye","stage":"eye-motility","english":"Look straight ahead.","linked_terms":[],"translation":"望正前面。","transliteration":"mong jeng chin-min","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-check","field":"eye","stage":"eye-pressure","english":"I am going to check the pressure in your eye.","linked_terms":[],"translation":"我要度你嘅眼壓。","transliteration":"ngaw yiu dok nay geh ngahn-ahp","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-no-hurt","field":"eye","stage":"eye-pressure","english":"This does not hurt. You will feel a light touch on your eye.","linked_terms":[],"translation":"呢個唔會痛，你會覺得對眼俾人輕輕掂到。","transliteration":"nee-gaw mm-wooi tung, nay wooi gok-duk doy ngahn bay yun ching-ching dim-doe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-still","field":"eye","stage":"eye-pressure","english":"Please look straight ahead and hold still. Try not to blink.","linked_terms":[],"translation":"請望正前面，唔好郁，盡量唔好眨眼。","transliteration":"ching mong jeng chin-min, mm-hoe yuke, jun-leung mm-hoe jaam ngahn","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-fix","field":"eye","stage":"eye-fields","english":"Keep looking at my nose, not at my hand.","linked_terms":[],"translation":"一直望住我個鼻，唔好望我隻手。","transliteration":"yat-jick mong-jyu ngaw gaw bay, mm-hoe mong ngaw jek sow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-raise","field":"eye","stage":"eye-fields","english":"Raise your hand when you see my fingers.","linked_terms":[],"translation":"見到我隻手指就舉手。","transliteration":"gin-doh ngaw jek sow-jee jow gui sow","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-count","field":"eye","stage":"eye-fields","english":"How many fingers do you see now?","linked_terms":[],"translation":"而家見到幾多隻手指？","transliteration":"yee-gah gin-doh gay-daw jek sow-jee?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-allergy","field":"eye","stage":"eye-drops","english":"Are you allergic to any medications?","linked_terms":[],"translation":"你有冇藥物敏感？","transliteration":"nay yow-moe yeuk-mat mun-gum?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-putting","field":"eye","stage":"eye-drops","english":"I'm going to put drops in your eye.","linked_terms":[],"translation":"我要幫你滴眼藥水。","transliteration":"ngaw yiu bong nay dick ngahn-yeuk-soy","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-look-up","field":"eye","stage":"eye-drops","english":"Please look up.","linked_terms":[],"translation":"請望上。","transliteration":"ching mong seung","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-anaesthetic","field":"eye","stage":"eye-drops","english":"This is an analgesic for your eyes. It may sting for a few seconds.","linked_terms":[],"translation":"呢啲係眼嘅麻藥，可能會刺痛幾秒。","transliteration":"nee-dee high ngahn geh mah-yeuk, haw-nahng wooi chee-tung gay miu","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-dilate","field":"eye","stage":"eye-drops","english":"This drop will dilate your pupils.","linked_terms":[],"translation":"呢啲係散瞳藥水。","transliteration":"nee-dee high sahn-tung yeuk-soy","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-blurry","field":"eye","stage":"eye-drops","english":"Your vision will be blurry for about 6 hours.","linked_terms":[],"translation":"你嘅視力會矇大概六個鐘。","transliteration":"nay geh see-lick wooi mung dye-hoy luke gaw jung","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-close","field":"eye","stage":"eye-drops","english":"Please close your eyes.","linked_terms":[],"translation":"請閉埋眼。","transliteration":"ching bye-my ngahn","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-no-rub","field":"eye","stage":"eye-drops","english":"Don't rub your eyes.","linked_terms":[],"translation":"唔好捽眼。","transliteration":"mm-hoe jut ngahn","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-chin","fie
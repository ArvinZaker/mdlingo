[{"id":"eye-intro-doctor","field":"eye","stage":"eye-intro","english":"I am your eye doctor.","linked_terms":[],"translation":"ਮੈਂ ਤੁਹਾਡਾ ਅੱਖਾਂ ਦਾ ਡਾਕਟਰ ਹਾਂ।","transliteration":"mane tu-hah-da uh-khan da dahk-tar haan","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-sit","field":"eye","stage":"eye-intro","english":"Please sit here.","linked_terms":[],"translation":"ਕਿਰਪਾ ਕਰਕੇ ਇੱਥੇ ਬੈਠੋ।","transliteration":"kir-pa kar-kay ih-thay bay-toe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-pain","field":"eye","stage":"eye-intro","english":"Does it hurt? Point to where.","linked_terms":[],"translation":"ਦਰਦ ਹੈ? ਕਿੱਥੇ? ਇਸ਼ਾਰਾ ਕਰੋ।","transliteration":"dard hay? kih-thay? ih-shah-ra kuh-roe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-intro-fam-glaucoma","field":"eye","stage":"eye-intro","english":"Do you have a family history of glaucoma?","linked_terms":[],"translation":"ਤੁਹਾਡੇ ਪਰਿਵਾਰ ਵਿੱਚ ਕਿਸੇ ਨੂੰ ਕਾਲਾ ਮੋਤੀਆ ਹੋਇਆ ਹੈ?","transliteration":"tu-hah-day pa-ree-vaar vich kih-say noo kah-la moe-tee-ah hoe-ee-ah hay?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-glasses-on","field":"eye","stage":"eye-acuity","english":"Put your glasses on.","linked_terms":[],"translation":"ਕਿਰਪਾ ਕਰਕੇ ਐਨਕ ਲਗਾਓ।","transliteration":"kir-pa kar-kay eye-nak lug-ah-oh","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-cover-left","field":"eye","stage":"eye-acuity","english":"Cover your left eye.","linked_terms":[],"translation":"ਖੱਬੀ ਅੱਖ ਢੱਕੋ।","transliteration":"khub-bee ukh dhuk-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-cover-right","field":"eye","stage":"eye-acuity","english":"Cover your right eye.","linked_terms":[],"translation":"ਸੱਜੀ ਅੱਖ ਢੱਕੋ।","transliteration":"suj-jee ukh dhuk-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-sym-ask","field":"eye","stage":"eye-acuity","english":"Does your vision look like any of these? Point to the closest one.","linked_terms":[],"translation":"ਤੁਹਾਡੀ ਨਜ਼ਰ ਕਿਹੜੀ ਵਰਗੀ ਹੈ? ਸਭ ਤੋਂ ਨੇੜੇ ਵਾਲੀ ਵੱਲ ਇਸ਼ਾਰਾ ਕਰੋ।","transliteration":"tu-hah-dee nuh-zar keh-ree var-gee hay? sub tone nay-ray vah-lee vull ih-shah-ra kuh-roe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-read-line","field":"eye","stage":"eye-acuity","english":"Please read the smallest line you can see.","linked_terms":[],"translation":"ਜੋ ਸਭ ਤੋਂ ਛੋਟੀ ਲਾਈਨ ਦਿਸਦੀ ਹੈ ਉਹ ਪੜ੍ਹੋ।","transliteration":"joe sub tone choh-tee line dis-dee hay oh puh-roe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-pinhole","field":"eye","stage":"eye-acuity","english":"Try to look through the tiny hole. It may make your vision clearer.","linked_terms":[],"translation":"ਛੋਟੀ ਮੋਰੀ ਵਿੱਚੋਂ ਦੇਖੋ, ਸ਼ਾਇਦ ਸਾਫ਼ ਦਿਸੇ।","transliteration":"choh-tee moh-ree vich-ohn day-koe, shy-ad saaf dis-say","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-fingers","field":"eye","stage":"eye-acuity","english":"How many fingers?","linked_terms":[],"translation":"ਕਿੰਨੀਆਂ ਉਂਗਲਾਂ?","transliteration":"kin-nee-yan oong-lan?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-hand-motion","field":"eye","stage":"eye-acuity","english":"Do you see my hand moving?","linked_terms":[],"translation":"ਕੀ ਤੁਹਾਨੂੰ ਮੇਰਾ ਹੱਥ ਹਿੱਲਦਾ ਦਿਸਦਾ ਹੈ?","transliteration":"kee tu-hah-noo may-ra hutth hil-da dis-da hay?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-see-this","field":"eye","stage":"eye-acuity","english":"Can you see this?","linked_terms":[],"translation":"ਕੀ ਇਹ ਦਿਸਦਾ ਹੈ?","transliteration":"kee ih dis-dah hay?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-light-move","field":"eye","stage":"eye-acuity","english":"Tell me if you see the light move.","linked_terms":[],"translation":"ਜੇ ਰੌਸ਼ਨੀ ਹਿਲਦੀ ਦਿਸੇ ਤਾਂ ਦੱਸੋ।","transliteration":"jay rowsh-nee hil-dee dis-say tahn dus-so","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-look-nose","field":"eye","stage":"eye-acuity","english":"Look at my nose.","linked_terms":[],"translation":"ਮੇਰੇ ਨੱਕ ਵੱਲ ਦੇਖੋ।","transliteration":"may-ray nuck vull day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-double","field":"eye","stage":"eye-acuity","english":"Do you see two of me?","linked_terms":[],"translation":"ਕੀ ਤੁਹਾਨੂੰ ਦੋ ਦਿਸਦੇ ਹਨ?","transliteration":"kee tu-hah-noo doe dis-day hun?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vis-worse-direction","field":"eye","stage":"eye-acuity","english":"Is it worse looking this way?","linked_terms":[],"translation":"ਇਸ ਪਾਸੇ ਦੇਖਣ ਤੇ ਵੱਧ ਹੁੰਦਾ ਹੈ?","transliteration":"iss pah-say day-khan tay vudh hoon-da hay?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-shine","field":"eye","stage":"eye-pupils","english":"I am going to shine a light in your eyes. Please look at the wall behind me.","linked_terms":[],"translation":"ਹੁਣ ਅੱਖਾਂ ਵਿੱਚ ਰੌਸ਼ਨੀ ਪਾਉਣੀ ਹੈ। ਮੇਰੇ ਪਿੱਛੇ ਕੰਧ ਵੱਲ ਦੇਖੋ।","transliteration":"hun uh-khan vich rowsh-nee pow-nee hay. may-ray pih-chay kundh vull day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-dont-look-light","field":"eye","stage":"eye-pupils","english":"Do not look at the light. Keep looking far away.","linked_terms":[],"translation":"ਰੌਸ਼ਨੀ ਵੱਲ ਨਾ ਦੇਖੋ, ਦੂਰ ਦੇਖਦੇ ਰਹੋ।","transliteration":"rowsh-nee vull na day-koe, door day-kh-day ruh-hoe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-pup-both-open","field":"eye","stage":"eye-pupils","english":"Keep both eyes open.","linked_terms":[],"translation":"ਦੋਵੇਂ ਅੱਖਾਂ ਖੁੱਲ੍ਹੀਆਂ ਰੱਖੋ।","transliteration":"doe-ven uh-khan khul-lee-yan ruh-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-look-here","field":"eye","stage":"eye-motility","english":"Look here.","linked_terms":[],"translation":"ਇੱਥੇ ਦੇਖੋ।","transliteration":"ih-thay day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-finger","field":"eye","stage":"eye-motility","english":"Look at my finger. Do not move your head.","linked_terms":[],"translation":"ਮੇਰੀ ਉਂਗਲ ਵੱਲ ਦੇਖੋ। ਸਿਰ ਨਾ ਹਿਲਾਓ।","transliteration":"may-ree oon-gal vull day-koe. sir na hih-lah-oh","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-up","field":"eye","stage":"eye-motility","english":"Look up.","linked_terms":[],"translation":"ਉੱਪਰ ਦੇਖੋ।","transliteration":"oop-par day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-down","field":"eye","stage":"eye-motility","english":"Look down.","linked_terms":[],"translation":"ਹੇਠਾਂ ਦੇਖੋ।","transliteration":"hay-thaan day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-left","field":"eye","stage":"eye-motility","english":"Look left.","linked_terms":[],"translation":"ਖੱਬੇ ਦੇਖੋ।","transliteration":"khub-bay day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-right","field":"eye","stage":"eye-motility","english":"Look right.","linked_terms":[],"translation":"ਸੱਜੇ ਦੇਖੋ।","transliteration":"suj-jay day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-mot-straight","field":"eye","stage":"eye-motility","english":"Look straight ahead.","linked_terms":[],"translation":"ਸਿੱਧਾ ਸਾਹਮਣੇ ਦੇਖੋ।","transliteration":"sid-dha saah-muh-nay day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-check","field":"eye","stage":"eye-pressure","english":"I am going to check the pressure in your eye.","linked_terms":[],"translation":"ਹੁਣ ਅੱਖ ਦਾ ਦਬਾਅ ਜਾਂਚਣਾ ਹੈ।","transliteration":"hun ukh da duh-bah jaan-chuh-na hay","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-no-hurt","field":"eye","stage":"eye-pressure","english":"This does not hurt. You will feel a light touch on your eye.","linked_terms":[],"translation":"ਇਸ ਵਿੱਚ ਦਰਦ ਨਹੀਂ ਹੁੰਦਾ। ਅੱਖ ਉੱਤੇ ਹਲਕਾ ਜਿਹਾ ਛੋਹ ਮਹਿਸੂਸ ਹੋਵੇਗਾ।","transliteration":"iss vich dard nuh-heen hoon-da. ukh oo-tay hul-ka jih-ha choh muh-soos hoe-vay-ga","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-iop-still","field":"eye","stage":"eye-pressure","english":"Please look straight ahead and hold still. Try not to blink.","linked_terms":[],"translation":"ਸਿੱਧਾ ਸਾਹਮਣੇ ਦੇਖੋ, ਹਿੱਲੋ ਨਾ, ਅਤੇ ਪਲਕ ਨਾ ਝਪਕੋ।","transliteration":"sid-dha saah-muh-nay day-koe, hil-loe na, uh-tay puh-luck na jhup-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-fix","field":"eye","stage":"eye-fields","english":"Keep looking at my nose, not at my hand.","linked_terms":[],"translation":"ਮੇਰੇ ਨੱਕ ਵੱਲ ਦੇਖਦੇ ਰਹੋ, ਮੇਰੇ ਹੱਥ ਵੱਲ ਨਾ ਦੇਖੋ।","transliteration":"may-ray nuck vull day-kh-day ruh-hoe, may-ray hath vull na day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-raise","field":"eye","stage":"eye-fields","english":"Raise your hand when you see my fingers.","linked_terms":[],"translation":"ਮੇਰੀਆਂ ਉਂਗਲਾਂ ਦਿਸਣ ਤੇ ਹੱਥ ਚੁੱਕੋ।","transliteration":"may-ree-yan oong-lan dis-san tay hath chuk-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-vf-count","field":"eye","stage":"eye-fields","english":"How many fingers do you see now?","linked_terms":[],"translation":"ਹੁਣ ਕਿੰਨੀਆਂ ਉਂਗਲਾਂ ਦਿਸਦੀਆਂ ਹਨ?","transliteration":"hun kin-nee-yan oong-lan dis-dee-yan hun?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-allergy","field":"eye","stage":"eye-drops","english":"Are you allergic to any medications?","linked_terms":[],"translation":"ਕੀ ਤੁਹਾਨੂੰ ਕਿਸੇ ਦਵਾਈ ਤੋਂ ਐਲਰਜੀ ਹੈ?","transliteration":"kee tu-hah-noo kih-say duh-vye tone al-ler-jee hay?","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-putting","field":"eye","stage":"eye-drops","english":"I'm going to put drops in your eye.","linked_terms":[],"translation":"ਹੁਣ ਤੁਹਾਡੀ ਅੱਖ ਵਿੱਚ ਬੂੰਦਾਂ ਪਾਉਣੀਆਂ ਹਨ।","transliteration":"hun tu-hah-dee ukh vich boon-daan pow-nee-yan hun","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-look-up","field":"eye","stage":"eye-drops","english":"Please look up.","linked_terms":[],"translation":"ਕਿਰਪਾ ਕਰਕੇ ਉੱਪਰ ਦੇਖੋ।","transliteration":"kir-pa kar-kay oop-par day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-anaesthetic","field":"eye","stage":"eye-drops","english":"This is an analgesic for your eyes. It may sting for a few seconds.","linked_terms":[],"translation":"ਇਹ ਅੱਖ ਸੁੰਨ ਕਰਨ ਵਾਲੀ ਦਵਾਈ ਹੈ। ਕੁਝ ਸਕਿੰਟ ਚੁਭ ਸਕਦੀ ਹੈ।","transliteration":"ih ukh soon kuh-ran vah-lee duh-vye hay. kuj sa-kint chubh suk-dee hay","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-dilate","field":"eye","stage":"eye-drops","english":"This drop will dilate your pupils.","linked_terms":[],"translation":"ਇਹ ਬੂੰਦ ਪੁਤਲੀ ਖੋਲ੍ਹ ਦੇਵੇਗੀ।","transliteration":"ih boond poot-lee kohl day-vay-gee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-blurry","field":"eye","stage":"eye-drops","english":"Your vision will be blurry for about 6 hours.","linked_terms":[],"translation":"ਨਜ਼ਰ ਲਗਭਗ ਛੇ ਘੰਟੇ ਧੁੰਦਲੀ ਰਹੇਗੀ।","transliteration":"nuh-zar lug-bhug chay ghun-tay dhoond-lee ruh-hay-gee","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-close","field":"eye","stage":"eye-drops","english":"Please close your eyes.","linked_terms":[],"translation":"ਕਿਰਪਾ ਕਰਕੇ ਅੱਖਾਂ ਬੰਦ ਕਰੋ।","transliteration":"kir-pa kar-kay uh-khan bund kuh-roe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-drp-no-rub","field":"eye","stage":"eye-drops","english":"Don't rub your eyes.","linked_terms":[],"translation":"ਅੱਖਾਂ ਨਾ ਮਲੋ।","transliteration":"uh-khan na mah-loe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-chin","field":"eye","stage":"eye-slitlamp","english":"Chin on the rest, forehead against the bar.","linked_terms":[],"translation":"ਠੋਡੀ ਇੱਥੇ ਰੱਖੋ, ਮੱਥਾ ਇਸ ਪੱਟੀ ਨਾਲ ਲਗਾਓ।","transliteration":"toe-dee ih-thay ruh-koe, mut-tha iss put-tee null lug-ah-oh","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-open","field":"eye","stage":"eye-slitlamp","english":"Open your eyes wide.","linked_terms":[],"translation":"ਅੱਖਾਂ ਪੂਰੀਆਂ ਖੋਲ੍ਹੋ।","transliteration":"uh-khan poo-ree-yan koh-loe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-no-pull-back","field":"eye","stage":"eye-slitlamp","english":"Don't pull your head back.","linked_terms":[],"translation":"ਸਿਰ ਪਿੱਛੇ ਨਾ ਕਰੋ।","transliteration":"sir pih-chay na kuh-roe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-bright","field":"eye","stage":"eye-slitlamp","english":"The light is bright. Please bear with it.","linked_terms":[],"translation":"ਰੌਸ਼ਨੀ ਤੇਜ਼ ਹੈ। ਥੋੜ੍ਹਾ ਬਰਦਾਸ਼ਤ ਕਰੋ।","transliteration":"rowsh-nee tayz hay. tore-ha bar-dasht kuh-roe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-ear","field":"eye","stage":"eye-slitlamp","english":"Look at my ear.","linked_terms":[],"translation":"ਮੇਰੇ ਕੰਨ ਵੱਲ ਦੇਖੋ।","transliteration":"may-ray kunn vull day-koe","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-touch-lid","field":"eye","stage":"eye-slitlamp","english":"I'm going to touch your eyelid.","linked_terms":[],"translation":"ਹੁਣ ਤੁਹਾਡੀ ਪਲਕ ਨੂੰ ਛੂਹਣਾ ਹੈ।","transliteration":"hun tu-hah-dee puh-luck noo chooh-na hay","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-slit-almost","field":"eye","stage":"eye-slitlamp","english":"Almost done.","linked_terms":[],"translation":"ਲਗਭਗ ਹੋ ਗਿਆ।","transliteration":"lug-bhug hoe gee-ah","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-finished","field":"eye","stage":"eye-closing","english":"The exam is finished. Thank you.","linked_terms":[],"translation":"ਜਾਂਚ ਪੂਰੀ ਹੋ ਗਈ। ਧੰਨਵਾਦ।","transliteration":"jaanch poo-ree hoe guy. dhun-vaad","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-healthy","field":"eye","stage":"eye-closing","english":"Your eyes are healthy.","linked_terms":[],"translation":"ਤੁਹਾਡੀਆਂ ਅੱਖਾਂ ਠੀਕ ਹਨ।","transliteration":"tu-hah-dee-yan uh-khan teek hun","translator":"Eyelingual","reviewer":"","status":"draft","reviewed_on":"","comment":""},{"id":"eye-close-consult","field":"eye","stage":"eye-closing","english":"I will have to speak to another doctor about your eyes. I will be back.","linked_terms":[],"translation":"ਤੁਹਾਡੀਆਂ ਅੱਖਾਂ ਬਾਰੇ ਦੂਜੇ ਡਾਕਟਰ ਨਾਲ ਗੱਲ ਕਰਨੀ ਹੈ। ਥੋੜ੍ਹੀ ਦੇਰ ਬਾਅਦ ਵਾਪਸ ਆਉਣਾ ਹੈ।"